{
  "manifest_version": 3,
  "name": "BOSS 岗位采集器",
  "version": "1.2.0",
  "description": "点击采集 BOSS 直聘当前岗位，保存在本地并可导出。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.notion.com/*", "https://www.zhipin.com/*", "https://*.zhipin.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "采集当前岗位" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"], "js": ["content.js"] }]
}
